{
  // ==========================================================
  //  Cấu hình triển khai lên Cloudflare Workers
  //  Bạn không cần sửa file này.
  // ==========================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vessca-web",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",

  "assets": {
    // Thư mục chứa web đã dựng xong (do build.mjs sinh ra)
    "directory": "./dist",
    "binding": "ASSETS",
    // /blog/bai-viet  →  /blog/bai-viet/index.html
    "html_handling": "auto-trailing-slash",
    // Phải để "none" thì các đường dẫn không phải file tĩnh (như /admin)
    // mới chạy được qua worker.js. Trang 404 do worker.js tự trả về.
    "not_found_handling": "none"
  },

  // Kho chứa đơn đặt lịch từ website
  "d1_databases": [
    {
      "binding": "BOOKINGS",
      "database_name": "vessca-bookings",
      "database_id": "6a9042a3-a9dc-4dfb-a864-399c7f132176"
    }
  ],

  // Quyền gửi mail báo đơn mới.
  // Cố định đích đến là hộp thư của tiệm — nghĩa là dù có lỗ hổng nào
  // trong mã, cái này cũng KHÔNG gửi thư đi đâu khác được.
  "send_email": [
    {
      "name": "NOTIFY_EMAIL",
      "destination_address": "lamiesnail@gmail.com"
    }
  ],

  // Hai giá trị này không phải bí mật nên để thẳng trong file,
  // mỗi lần build lại vẫn còn nguyên.
  "vars": {
    "GITHUB_REPO": "vessca-nail/vessca-web",
    "GITHUB_BRANCH": "main",
    "NOTIFY_TO": "lamiesnail@gmail.com"
  },

  // QUAN TRỌNG: giữ lại các biến đã đặt trong Cloudflare.
  // Không có dòng này, mỗi lần build lại sẽ xoá sạch mật khẩu
  // và token đã điền trên dashboard.
  "keep_vars": true,

  // Chạy định kỳ — giờ UTC (Việt Nam = UTC+7): 08:31, 09:31, 14:31, 20:31.
  // Đăng bài hẹn giờ đúng giờ + lấy ảnh Pexels cho bài blog.
  "triggers": {
    "crons": ["31 1 * * *", "31 2 * * *", "31 7 * * *", "31 13 * * *"]
  },

  "observability": {
    "enabled": true
  }
}
